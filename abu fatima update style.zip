/* =========================================================
   ABU FATIMA CAR ACCESSORIES
   Main Website Stylesheet
   Oman • Barka
   ========================================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Kufi+Arabic:wght@400;500;600;700;800&display=swap');

/* -------------------------
   DESIGN TOKENS
------------------------- */

:root {
    --primary: #e50914;
    --primary-dark: #b70710;
    --black: #090909;
    --dark: #111111;
    --dark-2: #181818;
    --white: #ffffff;
    --light: #f6f6f6;
    --gray: #777777;
    --border: #e5e5e5;

    --container: 1180px;

    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 22px;

    --shadow-sm: 0 4px 15px rgba(0, 0, 0, 0.07);
    --shadow-md: 0 12px 35px rgba(0, 0, 0, 0.12);
    --shadow-lg: 0 20px 55px rgba(0, 0, 0, 0.18);

    --transition: 0.25s ease;
}

/* -------------------------
   RESET
------------------------- */

*,
*::before,
*::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    margin: 0;
    background: var(--white);
    color: var(--dark);
    font-family: "Inter", Arial, sans-serif;
    line-height: 1.6;
    overflow-x: hidden;
}

img {
    display: block;
    max-width: 100%;
    height: auto;
}

a {
    color: inherit;
    text-decoration: none;
}

button,
input,
textarea,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

ul,
ol {
    list-style: none;
}

/* Arabic support */

[dir="rtl"],
.arabic {
    font-family: "Noto Kufi Arabic", "Inter", Arial, sans-serif;
}

/* -------------------------
   CONTAINER
------------------------- */

.container {
    width: min(92%, var(--container));
    margin-inline: auto;
}

/* -------------------------
   TOP BAR
------------------------- */

.top-bar {
    background: var(--black);
    color: var(--white);
    padding: 8px 0;
    font-size: 13px;
}

.top-bar .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.top-bar a {
    transition: color var(--transition);
}

.top-bar a:hover {
    color: var(--primary);
}

/* -------------------------
   HEADER
------------------------- */

.site-header,
header {
    position: relative;
    z-index: 1000;
    background: var(--white);
    border-bottom: 1px solid var(--border);
}

.navbar {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.5px;
}

.logo span {
    color: var(--primary);
}

.logo img {
    max-height: 52px;
    width: auto;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-links a {
    position: relative;
    padding: 8px 0;
    font-weight: 600;
    font-size: 14px;
    transition: color var(--transition);
}

.nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--primary);
    transition: width var(--transition);
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--primary);
}

.nav-links a:hover::after,
.nav-links a.active::after {
    width: 100%;
}

/* -------------------------
   BUTTONS
------------------------- */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 46px;
    padding: 11px 22px;
    border: 0;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 800;
    transition:
        transform var(--transition),
        background var(--transition),
        box-shadow var(--transition);
}

.btn:hover {
    transform: translateY(-2px);
}

.btn-primary {
    background: var(--primary);
    color: var(--white);
    box-shadow: 0 8px 20px rgba(229, 9, 20, 0.22);
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-dark {
    background: var(--black);
    color: var(--white);
}

.btn-outline {
    border: 1px solid var(--border);
    background: var(--white);
    color: var(--dark);
}

.btn-outline:hover {
    border-color: var(--primary);
    color: var(--primary);
}

/* WhatsApp */

.btn-whatsapp {
    background: #25d366;
    color: #fff;
}

.btn-whatsapp:hover {
    background: #1db954;
}

/* -------------------------
   HERO
------------------------- */

.hero {
    position: relative;
    min-height: 680px;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.88) 0%,
            rgba(0, 0, 0, 0.68) 45%,
            rgba(0, 0, 0, 0.25) 100%
        ),
        var(--hero-image, #111);
    background-size: cover;
    background-position: center;
    color: var(--white);
}

.hero-content {
    max-width: 680px;
    position: relative;
    z-index: 2;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    padding: 8px 13px;
    border-radius: 50px;
    background: rgba(229, 9, 20, 0.15);
    border: 1px solid rgba(229, 9, 20, 0.5);
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
}

.hero h1 {
    margin-bottom: 20px;
    font-size: clamp(38px, 6vw, 72px);
    line-height: 1.03;
    font-weight: 900;
    letter-spacing: -2px;
}

.hero h1 span {
    color: var(--primary);
}

.hero p {
    max-width: 590px;
    margin-bottom: 30px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 18px;
}

.hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

/* -------------------------
   TINTING HIGHLIGHT
------------------------- */

.tint-highlight {
    position: relative;
    margin-top: -70px;
    z-index: 10;
}

.tint-card {
    padding: 30px;
    border-radius: var(--radius-lg);
    background: var(--black);
    color: var(--white);
    box-shadow: var(--shadow-lg);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.tint-card-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 30px;
}

.tint-card h2 {
    margin-bottom: 8px;
    font-size: 28px;
    font-weight: 900;
}

.tint-card p {
    color: #bdbdbd;
}

.tint-card .price {
    color: var(--primary);
    font-size: 30px;
    font-weight: 900;
}

/* -------------------------
   SECTION
------------------------- */

.section {
    padding: 90px 0;
}

.section-light {
    background: var(--light);
}

.section-dark {
    background: var(--black);
    color: var(--white);
}

.section-heading {
    max-width: 720px;
    margin: 0 auto 45px;
    text-align: center;
}

.section-heading .eyebrow {
    margin-bottom: 10px;
    color: var(--primary);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.section-heading h2 {
    margin-bottom: 12px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.1;
    font-weight: 900;
}

.section-heading p {
    color: var(--gray);
}

/* -------------------------
   SERVICE GRID
------------------------- */

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.service-card {
    position: relative;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    transition:
        transform var(--transition),
        box-shadow var(--transition),
        border-color var(--transition);
}

.service-card:hover {
    transform: translateY(-5px);
    border-color: rgba(229, 9, 20, 0.3);
    box-shadow: var(--shadow-md);
}

.service-icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin-bottom: 20px;
    border-radius: 50%;
    background: var(--black);
    color: var(--white);
    font-size: 21px;
}

.service-card h3 {
    margin-bottom: 8px;
    font-size: 20px;
    font-weight: 800;
}

.service-card p {
    color: var(--gray);
    font-size: 14px;
}

/* -------------------------
   PRODUCTS
------------------------- */

.products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.product-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    transition: transform var(--transition), box-shadow var(--transition);
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
}

.product-image {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f1f1f1;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.product-card:hover .product-image img {
    transform: scale(1.05);
}

.product-info {
    padding: 18px;
}

.product-info h3 {
    margin-bottom: 5px;
    font-size: 16px;
    font-weight: 800;
}

.product-info p {
    margin-bottom: 12px;
    color: var(--gray);
    font-size: 13px;
}

.product-price {
    color: var(--primary);
    font-size: 20px;
    font-weight: 900;
}

/* -------------------------
   PRICING
------------------------- */

.pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.price-card {
    position: relative;
    padding: 30px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
}

.price-card.featured {
    border: 2px solid var(--primary);
    box-shadow: var(--shadow-md);
}

.price-card .badge {
    position: absolute;
    top: 15px;
    right: 15px;
    padding: 5px 10px;
    border-radius: 50px;
    background: var(--primary);
    color: var(--white);
    font-size: 10px;
    font-weight: 900;
}

.price-card h3 {
    font-size: 22px;
    font-weight: 900;
}

.price-card .price {
    margin: 15px 0;
    font-size: 34px;
    font-weight: 900;
}

.price-card ul {
    margin: 20px 0;
}

.price-card li {
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    color: var(--gray);
    font-size: 14px;
}

/* -------------------------
   TRUST / FEATURES
------------------------- */

.features {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.feature {
    text-align: center;
    padding: 25px 15px;
}

.feature strong {
    display: block;
    margin-bottom: 5px;
    font-size: 18px;
    font-weight: 900;
}

.feature span {
    color: var(--gray);
    font-size: 13px;
}

/* -------------------------
   CONTACT
------------------------- */

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
}

.contact-card {
    padding: 30px;
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--shadow-sm);
}

.form-group {
    margin-bottom: 16px;
}

.form-group label {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 700;
}

.form-control {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    background: var(--white);
    transition: border-color var(--transition), box-shadow var(--transition);
}

.form-control:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.08);
}

/* -------------------------
   FOOTER
------------------------- */

footer {
    background: var(--black);
    color: var(--white);
    padding: 60px 0 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 35px;
    padding-bottom: 40px;
}

footer h3 {
    margin-bottom: 16px;
    font-size: 16px;
    font-weight: 800;
}

footer p,
footer li,
footer a {
    color: #999;
    font-size: 13px;
}

footer li {
    margin-bottom: 8px;
}

footer a:hover {
    color: var(--white);
}

.footer-bottom {
    padding-top: 20px;
    border-top: 1px solid #292929;
    text-align: center;
    color: #777;
    font-size: 12px;
}

/* -------------------------
   FLOATING WHATSAPP
------------------------- */

.whatsapp-float {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 9999;

    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    border-radius: 50%;
    background: #25d366;
    color: #fff;

    font-size: 26px;

    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);

    transition: transform var(--transition);
}

.whatsapp-float:hover {
    transform: scale(1.08);
}

/* -------------------------
   MOBILE MENU
------------------------- */

.menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--white);
    font-size: 20px;
}

/* -------------------------
   RTL
------------------------- */

html[dir="rtl"] .hero {
    background:
        linear-gradient(
            270deg,
            rgba(0, 0, 0, 0.88) 0%,
            rgba(0, 0, 0, 0.68) 45%,
            rgba(0, 0, 0, 0.25) 100%
        ),
        var(--hero-image, #111);
}

html[dir="rtl"] .nav-links a::after {
    right: 0;
    left: auto;
}

html[dir="rtl"] .whatsapp-float {
    right: auto;
    left: 20px;
}

/* -------------------------
   RESPONSIVE — TABLET
------------------------- */

@media (max-width: 992px) {

    .nav-links {
        gap: 18px;
    }

    .hero {
        min-height: 600px;
    }

    .services-grid,
    .pricing-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .products-grid {
        grid-template-columns: repeat(3, 1fr);
    }

    .features {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* -------------------------
   RESPONSIVE — MOBILE
------------------------- */

@media (max-width: 768px) {

    .top-bar .container {
        justify-content: center;
        text-align: center;
    }

    .top-bar .top-links {
        display: none;
    }

    .navbar {
        min-height: 68px;
    }

    .menu-toggle {
        display: grid;
        place-items: center;
    }

    .nav-links {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;

        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 0;

        padding: 10px 5%;
        background: var(--white);
        border-bottom: 1px solid var(--border);
        box-shadow: var(--shadow-md);
    }

    .nav-links.active {
        display: flex;
    }

    .nav-links a {
        display: block;
        padding: 13px 0;
        border-bottom: 1px solid var(--border);
    }

    .nav-links a::after {
        display: none;
    }

    .hero {
        min-height: 570px;
        background-position: center;
    }

    .hero h1 {
        font-size: 42px;
        letter-spacing: -1px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-actions .btn {
        width: 100%;
    }

    .tint-highlight {
        margin-top: -40px;
    }

    .tint-card {
        padding: 22px;
    }

    .tint-card-inner {
        grid-template-columns: 1fr;
    }

    .tint-card .price {
        font-size: 26px;
    }

    .section {
        padding: 65px 0;
    }

    .services-grid,
    .pricing-grid,
    .contact-grid {
        grid-template-columns: 1fr;
    }

    .products-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .features {
        grid-template-columns: 1fr 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }
}

/* -------------------------
   SMALL PHONES
------------------------- */

@media (max-width: 480px) {

    .container {
        width: 90%;
    }

    .logo {
        font-size: 18px;
    }

    .hero {
        min-height: 530px;
    }

    .hero h1 {
        font-size: 35px;
    }

    .hero p {
        font-size: 14px;
    }

    .products-grid {
        grid-template-columns: 1fr;
    }

    .features {
        grid-template-columns: 1fr;
    }

    .section-heading h2 {
        font-size: 30px;
    }

    .whatsapp-float {
        width: 52px;
        height: 52px;
        right: 14px;
        bottom: 14px;
    }

    html[dir="rtl"] .whatsapp-float {
        right: auto;
        left: 14px;
    }
}

/* -------------------------
   ACCESSIBILITY
------------------------- */

:focus-visible {
    outline: 3px solid rgba(229, 9, 20, 0.35);
    outline-offset: 3px;
}

/* -------------------------
   REDUCED MOTION
------------------------- */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
    }
}